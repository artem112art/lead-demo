    {
      "parameters": {
        "jsCode": "const compact = value => String(value ?? '').trim().replace(/\\s+/g, ' ');\nconst input = $json.raw;\nconst digits = compact(input.phone).replace(/\\D/g, '');\nconst normalizedDigits = digits.length === 11 && digits.startsWith('8') ? `7${digits.slice(1)}` : digits;\nconst email = compact(input.email).toLowerCase();\nconst phone = normalizedDigits ? `+${normalizedDigits}` : '';\nconst allowedSources = new Set(['website', 'referral', 'social', 'ads', 'email', 'other']);\nconst rawSource = compact(input.source).toLowerCase();\nconst parsedBudget = Number(input.budget);\nconst budget = Number.isFinite(parsedBudget) && parsedBudget >= 0 ? parsedBudget : null;\nconst seed = `${email}|${phone}|${compact(input.company)}|${Date.now()}`;\nlet hash = 2166136261;\nfor (const char of seed) hash = Math.imul(hash ^ char.charCodeAt(0), 16777619);\nconst leadId = `lead_${Date.now().toString(36)}_${(hash >>> 0).toString(36)}`;\nconst lead = {\n  lead_id: leadId, correlation_id: leadId, created_at: new Date().toISOString(),\n  name: compact(input.name), company: compact(input.company), email, phone,\n  service: compact(input.service), budget, message: compact(input.message),\n  source: allowedSources.has(rawSource) ? rawSource : 'other',\n  simulate_downstream_failure: Boolean(input.simulate_downstream_failure),\n  status: 'RECEIVED', approved: null, last_action: 'NORMALIZED', error_count: 0\n};\nreturn [{ json: { ...lead, config: $json.config, audit_events: [\n  ...$json.audit_events,\n  { step: 'NORMALIZED', status: 'OK', message: 'Contact fields and enums normalized' }\n] } }];"
