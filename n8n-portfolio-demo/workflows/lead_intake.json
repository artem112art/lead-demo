    {
      "parameters": {
        "jsCode": "let score = 0;\nconst reasons = [];\nconst add = (points, reason) => { score += points; reasons.push({ points, reason }); };\nconst clearTask = $json.message.length >= 40 && /(автомат|лид|запис|crm|интеграц|workflow|обработ|sales|support|booking)/i.test($json.message);\nconst spam = /(^|\\s)(test|spam|asdf|qwerty|тест)(\\s|$)/i.test($json.message);\nif ($json.budget !== null && $json.budget > 0) add(25, 'budget_provided');\nif ($json.budget !== null && $json.budget >= 300) add(15, 'budget_at_least_300');\nif (clearTask) add(20, 'clear_business_task');\nif ($json.company) add(15, 'company_provided');\nif ($json.phone) add(10, 'phone_provided');\nif ($json.email) add(10, 'email_provided');\nif (['website', 'referral'].includes($json.source)) add(5, 'high_intent_source');\nif ($json.message.length < 20) add(-20, 'message_too_short');\nif (spam) add(-30, 'spam_indicator');\nif (!$json.phone && !$json.email) add(-20, 'no_contact');\nscore = Math.max(0, Math.min(100, score));\nconst tier = score >= $json.config.hot_threshold ? 'HOT' : score >= $json.config.warm_threshold ? 'WARM' : 'COLD';\nconst summary = `${$json.name}${$json.company ? ` from ${$json.company}` : ''} wants ${$json.service || 'an automation solution'}. Budget: ${$json.budget ?? 'not specified'}. Problem: ${$json.message}. Recommended action: ${tier === 'HOT' ? 'review and contact within 15 minutes' : tier === 'WARM' ? 'send a focused follow-up' : 'retain for nurture without immediate notification'}.`;\nreturn [{ json: { ...$json, lead_score: score, lead_tier: tier, score_reasons: reasons, summary, status: 'QUALIFIED', last_action: 'SCORED', audit_events: [\n  { step: 'DUPLICATE_CHECK', status: 'UNIQUE', message: 'No matching contact found' },\n  { step: 'SCORED', status: 'OK', message: `Score ${score}; tier ${tier}` }\n] } }];"
