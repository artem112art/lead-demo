        "jsCode": "const raw = { ...($json.body ?? $json) };\ndelete raw._expected;\nconst bool = (value, fallback = false) => value === undefined ? fallback : String(value).toLowerCase() === 'true';\nconst num = (value, fallback) => Number.isFinite(Number(value)) ? Number(value) : fallback;\nconst config = {\n  demo_mode: bool($env.DEMO_MODE, true),\n  hot_threshold: num($env.HOT_THRESHOLD, 70),\n  warm_threshold: num($env.WARM_THRESHOLD, 40),\n  followup_delay_minutes: num($env.FOLLOWUP_DELAY_MINUTES, 1),\n  enable_telegram: bool($env.ENABLE_TELEGRAM),\n  enable_whatsapp: bool($env.ENABLE_WHATSAPP),\n  enable_email: bool($env.ENABLE_EMAIL),\n  mock_api_base_url: $env.MOCK_API_BASE_URL || 'http://mock-api:8080'\n};\nconst errors = [];\nif (!String(raw.name ?? '').trim()) errors.push({ field: 'name', code: 'REQUIRED' });\nif (!String(raw.email ?? '').trim() && !String(raw.phone ?? '').trim()) errors.push({ field: 'email_or_phone', code: 'REQUIRED' });\nif (!String(raw.message ?? '').trim()) errors.push({ field: 'message', code: 'REQUIRED' });\nif (!String(raw.source ?? '').trim()) errors.push({ field: 'source', code: 'REQUIRED' });\nconst correlationId = `request_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`;\nreturn [{ json: { raw, config, correlation_id: correlationId, valid: errors.length === 0, validation_errors: errors, audit_events: [\n  { step: 'RECEIVED', status: 'OK', message: 'Webhook payload received' },\n  { step: 'VALIDATED', status: errors.length ? 'ERROR' : 'OK', message: errors.length ? `Missing: ${errors.map(e => e.field).join(', ')}` : 'Required fields present' }\n] } }];"
